{
  "manifest_version": 3,
  "name": "CHAKRAVYUHA Active Tracker",
  "version": "1.0",
  "description": "Live threat tracking and floating widget overlay.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}